<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/matrix.webp" id="com.goldmotion.effects.v51.glyphmatrix" name="GM Glyph Matrix" desc="Source-driven procedural glyph cells with multiple symbol families, scan animation and terminal glow." category="drawing" tags="gm,glyph,matrix,ascii,terminal,digital" experimental="false">
<params><texture id="inputImg" srcType="content" /><spinner id="columns" default="72" min="12" max="240" step="1" label="Columns" /><spinner id="glyphDetail" default="5" min="2" max="9" step="1" label="Glyph Detail" /><spinner id="contrast" default="1.2" min="0.2" max="4" step="0.01" label="Contrast" /><spinner id="scan" default="0.2" min="0" max="1" step="0.01" label="Scan Glow" /><spinner id="evolution" default="0" min="-100" max="100" step="0.01" label="Evolution" /><color id="backgroundColor" default="#FF05090B" label="Background" alpha="false" /><color id="glyphColor" default="#FF62FF9A" label="Glyph Color" alpha="false" /><spinner id="sourceTint" default="0.25" min="0" max="1" step="0.01" label="Source Tint" type="percent" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7))+evolution)*43758.5453);}void main(){vec2 uv=acScreenNorm;float rows=columns*acScreenSize.y/max(acScreenSize.x,1.0);vec2 grid=vec2(columns,rows),cell=floor(uv*grid),f=fract(uv*grid)-.5;vec4 src=texture2DCv(inputImg.texture,(cell+.5)/grid);float l=clamp((dot(src.rgb,vec3(.2126,.7152,.0722))-.5)*contrast+.5,0.0,1.0);float code=floor(h(cell)*max(glyphDetail,2.0));float stroke=0.0;stroke+=1.0-smoothstep(.08,.16,abs(f.x+sin((f.y+code)*6.0)*.16));stroke+=1.0-smoothstep(.07,.15,abs(f.y-code*.035));stroke*=step(h(cell+code),l);stroke=clamp(stroke,0.0,1.0);float scanGlow=scan*pow(.5+.5*sin((uv.y+acTime*.08)*rows*.7),8.0);vec3 result=mix(backgroundColor.rgb,glyphColor.rgb*mix(vec3(1),src.rgb,sourceTint)*(1.0+scanGlow),stroke);gl_FragColor=vec4(mix(texture2DCv(inputImg.texture,uv).rgb,result,mixAmount),texture2DCv(inputImg.texture,uv).a);}]]></shader></effect>