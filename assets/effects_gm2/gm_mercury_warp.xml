<?xml version="1.0" encoding="UTF-8" ?>
<effect id="com.goldmotion.effects.gm.mercurywarp" name="GM Mercury Warp" desc="Liquid metal surface displacement." category="distortion" tags="liquid,metal,warp" thumb="thumb/GM_MERCURY_WARP.webp" experimental="false">
<params>
<texture id="inputImg" srcType="content" />
<spinner id="scale" default="10.0" min="1.0" max="50.0" step="1.0" label="Ripple Scale" />
<spinner id="depth" default="0.05" min="0.0" max="0.3" step="0.01" label="Depth" />
  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main() {
vec2 uv = acScreenNorm;
float x = sin(uv.y * scale + acTime) * depth;
float y = cos(uv.x * scale + acTime) * depth;
gl_FragColor = texture2DCv(inputImg.texture, uv + vec2(x, y));
}]]></shader>
</effect>