<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/Lens_breathing.webp" id="com.goldmotion.effects.v51.lensbreathingpro" name="GM Lens Breathing Pro" desc="Realistic focus breathing with optical scale, center drift, barrel response and edge exposure." category="distort" tags="gm,lens,breathing,focus,optical,camera" overdraw="true" max-overdraw="0.15" experimental="false">
<params><texture id="inputImg" srcType="content" /><point id="focusPoint" default="0.5,0.5" min="0,0" max="1,1" step="0.005" label="Focus Point" /><spinner id="focus" default="0" min="-1" max="1" step="0.01" label="Focus Position" /><spinner id="breathing" default="0.08" min="-0.5" max="0.5" step="0.005" label="Breathing" /><spinner id="distortion" default="0.06" min="-0.5" max="0.5" step="0.005" label="Optical Distortion" /><spinner id="driftPx" default="4" min="0" max="80" step="0.5" label="Focus Drift" /><spinner id="edgeExposure" default="0.08" min="-1" max="1" step="0.01" label="Edge Exposure" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){vec2 uv=acScreenNorm,sz=max(inputImg.size,vec2(1.0));float z=1.0+focus*breathing;vec2 drift=(focusPoint-.5)*driftPx/sz*focus;vec2 q=(uv-focusPoint)/max(z,.05);float r2=dot(q,q);q*=1.0+distortion*focus*r2;vec2 w=focusPoint+q+drift;vec4 src=texture2DCv(inputImg.texture,uv),dst=texture2DCv(inputImg.texture,clamp(w,0.0,1.0));dst.rgb*=1.0+edgeExposure*focus*smoothstep(.1,.8,r2);gl_FragColor=mix(src,dst,mixAmount);}]]></shader></effect>