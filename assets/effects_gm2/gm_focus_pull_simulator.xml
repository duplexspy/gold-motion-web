<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/focus_pull_simulator.webp" id="com.goldmotion.effects.v51.focuspullsimulator" name="GM Focus Pull Simulator" desc="Animated rack-focus plane with soft depth band, cinematic defocus and preserved in-focus detail." category="blur" tags="gm,focus,pull,rack,depth,defocus" overdraw="true" max-overdraw="0.55" experimental="false">
<params><texture id="inputImg" srcType="content" /><spinner id="focusPosition" default="0.5" min="-0.5" max="1.5" step="0.005" label="Focus Position" /><spinner id="angle" default="0" min="-3600" max="3600" step="0.5" type="angle" label="Focus Plane" /><spinner id="focusWidth" default="0.18" min="0.01" max="1" step="0.01" label="Focus Width" /><spinner id="feather" default="0.2" min="0.01" max="1" step="0.01" label="Feather" /><spinner id="blurPx" default="32" min="0" max="180" step="1" label="Defocus" /><spinner id="highlightBoost" default="0.35" min="0" max="3" step="0.01" label="Bokeh Highlights" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){vec2 uv=acScreenNorm,sz=max(inputImg.size,vec2(1.0));vec4 src=texture2DCv(inputImg.texture,uv),sum=vec4(0);float axis=dot(uv,vec2(cos(angle),sin(angle))),d=max(abs(axis-focusPosition)-focusWidth,0.0),defocus=smoothstep(0.0,max(feather,.001),d);float ws=0.0;for(int i=0;i<20;i++){float a=float(i)*2.39996323,r=sqrt((float(i)+.5)/20.0)*blurPx*defocus;vec4 c=texture2DCv(inputImg.texture,clamp(uv+vec2(cos(a),sin(a))*r/sz,0.0,1.0));float l=max(max(c.r,c.g),c.b),w=1.0+max(l-.65,0.0)*highlightBoost;sum+=c*w;ws+=w;}vec4 dst=sum/max(ws,.001);gl_FragColor=mix(src,dst,mixAmount*defocus);}]]></shader></effect>