<effect thumb="thumb/lumathreadsort.webp" id="com.goldmotion.effects.v51.lumathreadsort" name="GM Luma Thread Sort" desc="Threshold-gated luma threads that pull bright or dark pixels into coherent directional woven streaks." category="distort" tags="gm,luma,thread,sort,streak,pixel" overdraw="true" max-overdraw="0.35" experimental="false">
<params><texture id="inputImg" srcType="content" /><spinner id="thresholdLow" default="0.25" min="0" max="1" step="0.01" label="Threshold Low" /><spinner id="thresholdHigh" default="0.75" min="0" max="1" step="0.01" label="Threshold High" /><spinner id="distancePx" default="90" min="0" max="600" step="1" label="Thread Length" /><spinner id="angle" default="0" min="-3600" max="3600" step="0.5" type="angle" label="Direction" /><spinner id="samples" default="24" min="4" max="32" step="1" label="Samples" /><spinner id="weave" default="0.18" min="0" max="2" step="0.01" label="Weave" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){vec2 uv=acScreenNorm,sz=max(inputImg.size,vec2(1.0)),dir=vec2(cos(angle),sin(angle));vec4 src=texture2DCv(inputImg.texture,uv),sum=vec4(0);float ws=0.0,count=clamp(floor(samples+.5),4.0,32.0);for(int i=0;i<32;i++){if(float(i)>=count)break;float t=float(i)/max(count-1.0,1.0)-.5;vec2 perp=vec2(-dir.y,dir.x)*sin(t*12.0)*weave;vec4 c=texture2DCv(inputImg.texture,clamp(uv+(dir*t+perp*t*t)*distancePx/sz,0.0,1.0));float l=dot(c.rgb,vec3(.2126,.7152,.0722));float w=step(l,thresholdLow)+step(thresholdHigh,l);sum+=c*w;ws+=w;}vec4 dst=ws>.5?sum/ws:src;gl_FragColor=mix(src,dst,mixAmount);}]]></shader></effect>