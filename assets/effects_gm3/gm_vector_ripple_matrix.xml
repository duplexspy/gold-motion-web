<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/ripple_matrix.webp" id="com.goldmotion.effects.v51.vectorripplematrix" name="GM Vector Ripple Matrix" desc="Layered physical ripples with elliptical direction, damping, phase and chromatic wave refraction." category="distort" tags="gm,ripple,wave,water,vector,refraction" overdraw="true" max-overdraw="0.2" experimental="false">
<params><texture id="inputImg" srcType="content" /><point id="center" default="0.5,0.5" min="-1,-1" max="2,2" step="0.005" label="Center" /><spinner id="frequency" default="18" min="1" max="120" step="0.1" label="Frequency" /><spinner id="amplitudePx" default="16" min="-150" max="150" step="0.5" label="Amplitude" /><spinner id="damping" default="2.2" min="0" max="12" step="0.05" label="Damping" /><spinner id="ellipticity" default="1" min="0.1" max="5" step="0.01" label="Ellipticity" /><spinner id="angle" default="0" min="-3600" max="3600" step="0.5" type="angle" label="Direction" /><spinner id="phase" default="0" min="-100" max="100" step="0.01" label="Phase" /><spinner id="dispersion" default="0.2" min="0" max="2" step="0.01" label="Dispersion" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){vec2 uv=acScreenNorm,sz=max(inputImg.size,vec2(1.0));float c=cos(angle),s=sin(angle);vec2 q=mat2(c,-s,s,c)*(uv-center);q.x*=ellipticity;float r=length(q),wave=sin(r*frequency*6.2831853-phase)*exp(-r*damping);vec2 dir=(r>.0001?mat2(c,s,-s,c)*(q/r):vec2(0));vec2 off=dir*wave*amplitudePx/sz;vec4 src=texture2DCv(inputImg.texture,uv),mid=texture2DCv(inputImg.texture,clamp(uv+off,0.0,1.0));vec2 co=off*dispersion;vec3 rgb=vec3(texture2DCv(inputImg.texture,clamp(uv+off+co,0.0,1.0)).r,mid.g,texture2DCv(inputImg.texture,clamp(uv+off-co,0.0,1.0)).b);gl_FragColor=vec4(mix(src.rgb,rgb,mixAmount),mix(src.a,mid.a,mixAmount));}]]></shader></effect>