<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/scanline_drift.webp" id="com.goldmotion.effects.v51.scanlinedrift" name="GM Scanline Drift" desc="Multi-frequency scanline displacement with rolling drift, line jitter and luminance-reactive interference." category="distort" tags="gm,scanline,drift,interference,rolling,signal" overdraw="true" max-overdraw="0.2" experimental="false">
<params><texture id="inputImg" srcType="content" /><spinner id="lineDensity" default="180" min="20" max="1000" step="1" label="Line Density" /><spinner id="displacementPx" default="8" min="0" max="100" step="0.5" label="Displacement" /><spinner id="driftSpeed" default="0.3" min="-6" max="6" step="0.01" label="Drift Speed" /><spinner id="interference" default="0.35" min="0" max="2" step="0.01" label="Interference" /><spinner id="lineDarken" default="0.18" min="0" max="1" step="0.01" label="Line Darken" /><spinner id="evolution" default="0" min="-100" max="100" step="0.01" label="Evolution" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[float h(float x){return fract(sin(x*12.9898)*43758.5453);}void main(){vec2 uv=acScreenNorm,sz=max(inputImg.size,vec2(1.0));float t=acTime*driftSpeed+evolution,line=floor((uv.y+t*.03)*lineDensity),rnd=h(line+floor(t*12.0));float wave=sin(uv.y*lineDensity*.37+t*5.0)+sin(uv.y*lineDensity*.071-t*3.0);float shift=(rnd-.5+wave*interference*.25)*displacementPx/sz.x;vec4 src=texture2DCv(inputImg.texture,uv),dst=texture2DCv(inputImg.texture,clamp(uv+vec2(shift,0),0.0,1.0));float scan=1.0-lineDarken*(.5+.5*sin(uv.y*lineDensity*3.14159265));dst.rgb*=scan;gl_FragColor=mix(src,dst,mixAmount);}]]></shader></effect>