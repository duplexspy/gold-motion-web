<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/spin_trail_composer.webp" id="com.goldmotion.effects.v51.spintrailcomposer" name="GM Spin Trail Composer" desc="Rotational echo composer with shutter arc, scale drift, weighted decay and edge-safe sampling." category="blur" tags="gm,spin,trail,rotation,echo,shutter" overdraw="true" max-overdraw="0.5" experimental="false">
<params><texture id="inputImg" srcType="content" /><point id="center" default="0.5,0.5" min="-1,-1" max="2,2" step="0.005" label="Center" /><spinner id="arc" default="35" min="-720" max="720" step="0.5" type="angle" label="Arc" /><spinner id="samples" default="20" min="4" max="32" step="1" label="Samples" /><spinner id="scaleDrift" default="0" min="-1" max="1" step="0.01" label="Scale Drift" /><spinner id="decay" default="0.9" min="0.1" max="1" step="0.01" label="Decay" /><spinner id="phase" default="0" min="-0.5" max="0.5" step="0.01" label="Shutter Phase" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){vec2 uv=acScreenNorm,q=uv-center;vec4 src=texture2DCv(inputImg.texture,uv),sum=vec4(0);float ws=0.0,count=clamp(floor(samples+.5),4.0,32.0);for(int i=0;i<32;i++){if(float(i)>=count)break;float t=(float(i)+.5)/count-.5+phase;float a=arc*t,c=cos(a),s=sin(a),w=pow(decay,abs(t)*count*.2);vec2 p=center+mat2(c,-s,s,c)*q/max(1.0+scaleDrift*t,.05);sum+=texture2DCv(inputImg.texture,clamp(p,0.0,1.0))*w;ws+=w;}gl_FragColor=mix(src,sum/max(ws,.001),mixAmount);}]]></shader></effect>