<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/Rolling_shutter_warp.webp" id="com.goldmotion.effects.v51.rollingshutterwarp" name="GM Rolling Shutter Warp" desc="Row-timed translation, skew, wobble and rotation for rolling-shutter correction or stylization." category="distort" tags="gm,rolling,shutter,warp,skew,wobble" overdraw="true" max-overdraw="0.2" experimental="false">
<params><texture id="inputImg" srcType="content" /><spinner id="amountPx" default="18" min="-300" max="300" step="1" label="Row Offset" /><spinner id="angle" default="0" min="-3600" max="3600" step="0.5" type="angle" label="Motion Direction" /><spinner id="skew" default="0.08" min="-1" max="1" step="0.005" label="Skew" /><spinner id="rotation" default="2" min="-45" max="45" step="0.1" type="angle" label="Row Rotation" /><spinner id="wobble" default="0.2" min="0" max="2" step="0.01" label="Wobble" /><spinner id="frequency" default="3" min="0.1" max="30" step="0.1" label="Wobble Frequency" /><spinner id="phase" default="0" min="-100" max="100" step="0.01" label="Phase" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){vec2 uv=acScreenNorm,sz=max(inputImg.size,vec2(1.0));float row=uv.y-.5,scan=row+sin(uv.y*frequency*6.2831853+phase)*wobble*.1;vec2 motion=vec2(cos(angle),sin(angle))*amountPx/sz*scan;float a=rotation*scan,c=cos(a),s=sin(a);vec2 q=mat2(c,-s,s,c)*(uv-.5);q.x+=skew*scan;vec2 w=q+.5+motion;vec4 src=texture2DCv(inputImg.texture,uv),dst=texture2DCv(inputImg.texture,clamp(w,0.0,1.0));gl_FragColor=mix(src,dst,mixAmount);}]]></shader></effect>