<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/polar_tunnel_warp.webp" id="com.goldmotion.effects.v51.polartunnelwarp" name="GM Polar Tunnel Warp" desc="Cartesian-to-polar tunnel remapping with radial repeat, seam rotation and mirrored edge-safe sampling." category="distort" tags="gm,polar,tunnel,warp,repeat,kaleido" overdraw="true" max-overdraw="0.3" experimental="false">
<params><texture id="inputImg" srcType="content" /><point id="center" default="0.5,0.5" min="0,0" max="1,1" step="0.005" label="Center" /><spinner id="depth" default="1" min="0.05" max="8" step="0.01" label="Depth" /><spinner id="repeat" default="2" min="0.25" max="12" step="0.05" label="Radial Repeat" /><spinner id="rotation" default="0" min="-3600" max="3600" step="0.5" type="angle" label="Rotation" /><spinner id="zoom" default="1" min="0.1" max="8" step="0.01" label="Zoom" /><spinner id="spiral" default="0.2" min="-4" max="4" step="0.01" label="Spiral" /><switch id="mirror" default="true" label="Mirror Repeat" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){vec2 uv=acScreenNorm,q=uv-center;float aspect=acScreenSize.x/max(acScreenSize.y,1.0);q.x*=aspect;float r=max(length(q),.0005),a=atan(q.y,q.x)+rotation;vec2 p=vec2(a/6.2831853+.5+log(r)*spiral,-log(r)*depth)*vec2(repeat,zoom);p=mirror?1.0-abs(mod(p,2.0)-1.0):fract(p);vec4 src=texture2DCv(inputImg.texture,uv),dst=texture2DCv(inputImg.texture,p);gl_FragColor=mix(src,dst,mixAmount);}]]></shader></effect>