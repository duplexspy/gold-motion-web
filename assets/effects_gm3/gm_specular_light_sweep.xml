<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/specular_light_sweep.webp" id="com.goldmotion.effects.v51.specularlightsweep" name="GM Specular Light Sweep" desc="Shape-aware metallic specular sweep with core, bloom, angle and highlight-only response." category="color" tags="gm,specular,light,sweep,shine,metal" overdraw="true" max-overdraw="0.35" experimental="false">
<params><texture id="inputImg" srcType="content" /><spinner id="position" default="0" min="-1" max="1" step="0.005" label="Position" /><spinner id="angle" default="-25" min="-3600" max="3600" step="0.5" type="angle" label="Angle" /><spinner id="width" default="0.08" min="0.002" max="1" step="0.002" label="Core Width" /><spinner id="bloom" default="0.22" min="0.01" max="1" step="0.01" label="Bloom" /><spinner id="shapeResponse" default="0.65" min="0" max="1" step="0.01" label="Shape Response" /><spinner id="intensity" default="1.5" min="0" max="10" step="0.05" label="Intensity" /><color id="lightColor" default="#FFFFE7C2" label="Light Color" alpha="false" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){vec2 uv=acScreenNorm;vec4 src=texture2DCv(inputImg.texture,uv);float axis=dot(uv-.5,vec2(cos(angle),sin(angle)))-position;float core=exp(-axis*axis/max(width*width,.000001));float halo=exp(-axis*axis/max(bloom*bloom,.000001))*.45;float l=dot(src.rgb,vec3(.2126,.7152,.0722));float response=mix(src.a,smoothstep(.05,.8,l)*src.a,shapeResponse);vec3 light=lightColor.rgb*(core+halo)*response*intensity;vec3 screen=1.0-(1.0-src.rgb)*(1.0-clamp(light,0.0,1.0));gl_FragColor=vec4(mix(src.rgb,screen,mixAmount),src.a+clamp(core+halo,0.0,1.0)*response*mixAmount*(1.0-src.a));}]]></shader></effect>