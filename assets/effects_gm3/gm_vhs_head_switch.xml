<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/head_switch.webp" id="com.goldmotion.effects.v51.vhsheadswitch" name="GM VHS Head Switch" desc="Authentic lower-frame VHS head-switch noise, tracking bend, chroma bleed and unstable tape timing." category="distort" tags="gm,vhs,head,switch,tape,tracking" overdraw="true" max-overdraw="0.25" experimental="false">
<params><texture id="inputImg" srcType="content" /><spinner id="switchPosition" default="0.88" min="0" max="1" step="0.005" label="Switch Position" /><spinner id="bandHeight" default="0.1" min="0.01" max="0.5" step="0.005" label="Band Height" /><spinner id="displacementPx" default="65" min="0" max="500" step="1" label="Tracking Bend" /><spinner id="noise" default="0.35" min="0" max="1" step="0.01" label="Tape Noise" /><spinner id="chromaBleedPx" default="12" min="0" max="80" step="0.5" label="Chroma Bleed" /><spinner id="jitterSpeed" default="24" min="1" max="60" step="1" label="Jitter Rate" /><spinner id="evolution" default="0" min="-100" max="100" step="0.01" label="Evolution" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[float h(vec2 p){return fract(sin(dot(p,vec2(12.9898,78.233)))*43758.5453);}void main(){vec2 uv=acScreenNorm,sz=max(inputImg.size,vec2(1.0));float frame=floor(acTime*jitterSpeed+evolution),y=(uv.y-switchPosition)/max(bandHeight,.001),band=1.0-smoothstep(0.0,1.0,abs(y));float bend=sin(y*9.0+frame)*band+(h(vec2(floor(uv.y*120.0),frame))-.5)*band;vec2 p=clamp(uv+vec2(bend*displacementPx/sz.x,0),0.0,1.0);vec4 src=texture2DCv(inputImg.texture,uv),dst=texture2DCv(inputImg.texture,p);vec2 bleed=vec2(chromaBleedPx/sz.x*band,0);dst.r=texture2DCv(inputImg.texture,clamp(p+bleed,0.0,1.0)).r;dst.b=texture2DCv(inputImg.texture,clamp(p-bleed,0.0,1.0)).b;dst.rgb+=(h(floor(uv*sz)+frame)-.5)*noise*band;gl_FragColor=mix(src,dst,mixAmount*band);}]]></shader></effect>