<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/rgb_rim_light.webp" id="com.goldmotion.effects.v51.rgbrimlight" name="GM RGB Rim Light" desc="Directional alpha/luma rim extraction with independent spectral offsets and additive edge bloom." category="drawing" tags="gm,rgb,rim,light,edge,spectral" overdraw="true" max-overdraw="0.4" experimental="false">
<params><texture id="inputImg" srcType="content" /><spinner id="distancePx" default="7" min="0.5" max="80" step="0.5" label="Rim Distance" /><spinner id="angle" default="-45" min="-3600" max="3600" step="0.5" type="angle" label="Light Direction" /><spinner id="softness" default="0.18" min="0.001" max="1" step="0.005" label="Softness" /><spinner id="spreadPx" default="3" min="0" max="30" step="0.5" label="RGB Spread" /><spinner id="intensity" default="1.4" min="0" max="8" step="0.05" label="Intensity" /><color id="rimColor" default="#FFFFFFFF" label="Rim Tint" alpha="false" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[float m(vec4 c){return max(c.a,dot(c.rgb,vec3(.2126,.7152,.0722)));}void main(){vec2 uv=acScreenNorm,sz=max(inputImg.size,vec2(1.0)),dir=vec2(cos(angle),sin(angle));vec4 src=texture2DCv(inputImg.texture,uv);float base=m(src),r=m(texture2DCv(inputImg.texture,clamp(uv-dir*(distancePx+spreadPx)/sz,0.0,1.0))),g=m(texture2DCv(inputImg.texture,clamp(uv-dir*distancePx/sz,0.0,1.0))),b=m(texture2DCv(inputImg.texture,clamp(uv-dir*(distancePx-spreadPx)/sz,0.0,1.0)));vec3 rim=smoothstep(vec3(0.0),vec3(max(softness,.001)),vec3(r,g,b)-base)*rimColor.rgb*intensity;vec3 outRgb=src.rgb+rim;gl_FragColor=vec4(mix(src.rgb,outRgb,mixAmount),max(src.a,clamp(max(max(rim.r,rim.g),rim.b),0.0,1.0)*mixAmount));}]]></shader></effect>