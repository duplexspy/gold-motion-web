<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/Elastic_fisheye.webp" id="com.goldmotion.effects.v51.elasticfisheye" name="GM Elastic Fisheye" desc="High-quality barrel/pincushion lens with elastic edge falloff, squeeze and chromatic correction." category="distort" tags="gm,fisheye,lens,barrel,pincushion,elastic" overdraw="true" max-overdraw="0.2" experimental="false">
<params><texture id="inputImg" srcType="content" /><point id="center" default="0.5,0.5" min="0,0" max="1,1" step="0.005" label="Center" /><spinner id="distortion" default="0.45" min="-2" max="2" step="0.01" label="Distortion" /><spinner id="elasticity" default="0.35" min="0" max="2" step="0.01" label="Elasticity" /><spinner id="radius" default="0.75" min="0.05" max="2" step="0.01" label="Radius" /><spinner id="squeeze" default="1" min="0.2" max="5" step="0.01" label="Anamorphic Squeeze" /><spinner id="chromaticPx" default="1" min="0" max="20" step="0.1" label="Chromatic Edge" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){vec2 uv=acScreenNorm,sz=max(inputImg.size,vec2(1.0));vec2 q=uv-center;q.x*=squeeze*acScreenSize.x/max(acScreenSize.y,1.0);float r=length(q)/max(radius,.001),mask=1.0-smoothstep(.85,1.15,r);float k=1.0+distortion*r*r+elasticity*r*r*r*r;vec2 w=(q/k);w.x/=squeeze*acScreenSize.x/max(acScreenSize.y,1.0);w+=center;vec2 dir=normalize(q+vec2(.0001))*chromaticPx/sz*r;vec4 src=texture2DCv(inputImg.texture,uv),mid=texture2DCv(inputImg.texture,clamp(w,0.0,1.0));vec3 rgb=vec3(texture2DCv(inputImg.texture,clamp(w+dir,0.0,1.0)).r,mid.g,texture2DCv(inputImg.texture,clamp(w-dir,0.0,1.0)).b);gl_FragColor=vec4(mix(src.rgb,rgb,mixAmount*mask),mix(src.a,mid.a,mixAmount*mask));}]]></shader></effect>