<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/DirectionalBokeh.webp" id="com.goldmotion.effects.v51.directionalbokehtrails" name="GM Directional Bokeh Trails" desc="Polygonal aperture trails with directional shutter length, highlight threshold and cat-eye shaping." category="blur" tags="gm,directional,bokeh,trails,aperture,blur" overdraw="true" max-overdraw="0.55" experimental="false">
<params><texture id="inputImg" srcType="content" /><spinner id="distancePx" default="55" min="0" max="400" step="1" label="Trail Distance" /><spinner id="angle" default="0" min="-3600" max="3600" step="0.5" type="angle" label="Direction" /><spinner id="aperture" default="6" min="3" max="10" step="1" label="Aperture Blades" /><spinner id="bokehPx" default="8" min="0" max="60" step="0.5" label="Bokeh Size" /><spinner id="threshold" default="0.45" min="0" max="2" step="0.01" label="Highlight Threshold" /><spinner id="catEye" default="0.25" min="0" max="1" step="0.01" label="Cat Eye" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){vec2 uv=acScreenNorm,sz=max(inputImg.size,vec2(1.0)),dir=vec2(cos(angle),sin(angle));vec4 src=texture2DCv(inputImg.texture,uv),sum=vec4(0);float ws=0.0,bl=clamp(floor(aperture+.5),3.0,10.0);for(int i=0;i<24;i++){float t=float(i)/23.0-.5;float aa=6.2831853*mod(float(i),bl)/bl;vec2 poly=vec2(cos(aa),sin(aa))*bokehPx/sz*(1.0-catEye*length(uv-.5));vec4 c=texture2DCv(inputImg.texture,clamp(uv+dir*distancePx/sz*t+poly,0.0,1.0));float l=max(max(c.r,c.g),c.b),w=.2+max(l-threshold,0.0);sum+=c*w;ws+=w;}gl_FragColor=mix(src,sum/max(ws,.001),mixAmount);}]]></shader></effect>