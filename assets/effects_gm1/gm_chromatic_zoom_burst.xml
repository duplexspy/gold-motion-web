<?xml version="1.0" encoding="UTF-8" ?>
<effect thumb="thumb/zoom_burst.webp" id="com.goldmotion.effects.v51.chromaticzoomburst" name="GM Chromatic Zoom Burst" desc="High-sample radial zoom burst with shutter weighting, center control and spectral separation." category="blur" tags="gm,chromatic,zoom,burst,radial,blur" overdraw="true" max-overdraw="0.5" experimental="false">
<params><texture id="inputImg" srcType="content" /><point id="center" default="0.5,0.5" min="-1,-1" max="2,2" step="0.005" label="Center" /><spinner id="amount" default="0.18" min="-1" max="1" step="0.005" label="Zoom Amount" /><spinner id="samples" default="24" min="4" max="32" step="1" label="Samples" /><spinner id="dispersion" default="0.012" min="0" max="0.1" step="0.001" label="Dispersion" /><spinner id="falloff" default="0.35" min="0" max="2" step="0.01" label="Edge Falloff" /><spinner id="mixAmount" default="1" min="0" max="1" step="0.01" label="Mix" type="percent" />  <section text="MOD BY PNKJ" />
</params>
<shader type="fragment" precision="high"><![CDATA[void main(){vec2 uv=acScreenNorm,q=uv-center;vec4 sum=vec4(0);float ws=0.0,count=clamp(floor(samples+.5),4.0,32.0);for(int i=0;i<32;i++){if(float(i)>=count)break;float t=(float(i)+.5)/count-.5,w=cos(t*3.14159265);vec2 p=center+q*(1.0+t*amount*2.0);vec2 d=normalize(q+vec2(.0001))*dispersion*t;vec4 m=texture2DCv(inputImg.texture,clamp(p,0.0,1.0));m.r=texture2DCv(inputImg.texture,clamp(p+d,0.0,1.0)).r;m.b=texture2DCv(inputImg.texture,clamp(p-d,0.0,1.0)).b;sum+=m*w;ws+=w;}vec4 src=texture2DCv(inputImg.texture,uv),dst=sum/max(ws,.0001);float mask=clamp(length(q)*(1.0+falloff),0.0,1.0);gl_FragColor=mix(src,dst,mixAmount*mask);}]]></shader></effect>